FROM python:3.12-slim

WORKDIR /app

# Install serving-only dependencies (smaller image than Dockerfile)
COPY docker/requirements-serve.txt .
RUN pip install --no-cache-dir -r requirements-serve.txt

# Copy source code
COPY src/ src/

# Create data directory
RUN mkdir -p data/raw data/processed data/predictions data/drift_reports

EXPOSE 8000 8501

CMD ["uvicorn", "src.serving.api:app", "--host", "0.0.0.0", "--port", "8000"]
