# ─────────────────────────────────────────────────────────────────────────────
# .env.example is the template for .env. `make setup` copies it and fills in
# your UID and GID. .env is gitignored; this template is committed.
#
# Who reads .env:
#   - `docker compose`, which substitutes ${VARS} in docker-compose.yml;
#   - the Makefile, which includes it so make and compose agree on ports etc.
# Python code never reads this file. Compose hands the relevant values to each
# container as environment variables, and each service documents the variables
# it reads at its entry point.
#
# Keep comments on their own lines. An inline "# comment" after a value would
# leave trailing spaces in the value for make.
# This file grows layer by layer (see PLAN.md §12).
# ─────────────────────────────────────────────────────────────────────────────

# Host user. Containers that write into ./data run as this UID:GID, so the
# files on the host belong to you rather than root. `make setup` fills these
# from `id -u` and `id -g`.
HOST_UID=1000
HOST_GID=1000

# ── source-api (layer 1) ────────────────────────────────────────────────────
# Host port for the synthetic API: http://localhost:8000/docs
SOURCE_API_PORT=8000
# Simulator overrides. They take precedence over config/source.toml.
# SIM_SPEED is simulated seconds per real second: 60 = 1 simulated hour per minute.
SIM_SEED=42
SIM_SPEED=60

# ── Kafka and Redpanda Console (layer 2) ────────────────────────────────────
# Host port of Kafka's EXTERNAL listener, for clients on your machine:
# bootstrap servers = localhost:9094. Containers use kafka:9092 (the INTERNAL
# listener) and never this port.
KAFKA_HOST_PORT=9094
# Redpanda Console (topics, messages, consumer groups): http://localhost:8081
CONSOLE_PORT=8081

# ── Spark analyzer (layer 3) ────────────────────────────────────────────────
# Optional parts of the stack, as compose profiles: "stream" = Spark, "batch" = Airflow.
# Read by docker compose itself. Empty = the core only (source, Kafka, bridge, Console).
COMPOSE_PROFILES=stream,batch
# Spark UI, with the Structured Streaming tab: http://localhost:4040
SPARK_UI_PORT=4040

# ── Airflow (layer 4) ────────────────────────────────────────────────────────
# Airflow web UI (no login locally): http://localhost:8080
AIRFLOW_PORT=8080
# Signs the tokens that Airflow's components exchange (Execution API). Any
# string works locally; it must be the same for every Airflow service.
AIRFLOW_JWT_SECRET=local-dev-only-jwt-secret
