# Runtime data written by the running stack (bind-mounted into containers):
# DuckDB files, Parquet lake, Spark checkpoints, simulator/bridge state.
data/

# Local environment
.venv/
.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# dbt artifacts (regenerated on every run): target/ and logs/ are Airflow's,
# the -host and -docs folders belong to `make dbt` and `make dbt-docs` on the host
transform/target/
transform/logs/
transform/target-host/
transform/target-docs/
transform/logs-host/
transform/dbt_packages/
transform/.user.yml

# Airflow task logs, if written to the host
orchestration/logs/
logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
